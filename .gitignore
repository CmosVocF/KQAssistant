# Gradle files
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# Local configuration file (sdk path, etc)
local.properties

# Local build environment (JDK/SDK/Gradle downloaded into here)
env/

# Android Studio / IntelliJ
.idea/
*.iml
*.ipr
*.iws
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files (do not commit signing keys)
*.jks
*.keystore

# OS files
.DS_Store
Thumbs.db

# Log files
*.log

# APK outputs (keep build outputs out of repo; attach to releases instead)
*.apk
*.ap_
*.aab
dist/

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Node / JS (if any)
node_modules/

# Python (modules/autoexam/backend)
__pycache__/
*.pyc

# 测试/敏感产物目录（不纳入仓库）
_deploytest/

# 用户提供的镟轮样例数据（含真实照片/姓名，不入库）
xuanlunshuju/

# Temporary files
*.tmp
*.swp
*~
